# Environment for the MCP server's docker compose. Copy to .env and edit.

# --- Image --------------------------------------------------------------
# Where `docker compose build` tags the image, and the version stamped into it.
# Each build produces both `:$TB_VERSION` and `:latest`. Keep these in step with
# the application's root .env so the whole stack ships as one version.
TB_REGISTRY=docker.io/chainfirelabs
TB_VERSION=1.7.0

# --- Reaching the API ---------------------------------------------------
# Service name + internal port, resolved on the application's compose network.
TB_MCP_API_BASE=http://backend:8000/api/v1
# The application's compose network, named after its directory. Change if the
# app lives in a directory other than `testbench`.
TB_MCP_APP_NETWORK=testbench_default

# --- Authentication -----------------------------------------------------
# A TestBench API key. Sign in to the web app, open Profile -> API keys,
# create one and paste it here — the full key is shown once, at creation.
#
# Pick the lowest role that does the job: `readonly` covers every tool except
# `search_audit`, which needs `admin`. The key can be revoked from the same
# page without touching the account it belongs to, which is the point of using
# one instead of a username and password.
TB_MCP_API_TOKEN=tb_0123456789ab_replace-me

# --- Serving on a domain (Traefik) --------------------------------------
# The proxy is part of docker-compose.yml, so `docker compose up -d` serves the
# endpoint over HTTPS with no extra -f flag. Plain HTTP redirects to HTTPS.
#
# TLS is Traefik's own default self-signed certificate — nothing to generate or
# trust. It carries no hostname, so clients must skip verification. Real
# certificates are expected to terminate on a proxy in front of this stack.
#
# WARNING: the MCP server does not authenticate its callers. It reads the fleet
# with TB_MCP_API_TOKEN's role, so anyone who can reach $TB_MCP_MOUNT_PATH reads
# the fleet. Set TB_MCP_MIDDLEWARES + TB_MCP_BASIC_AUTH below before putting this
# anywhere but a trusted network.

# The hostname the MCP endpoint answers on; clients connect to
# https://$TB_MCP_DOMAIN:$TB_MCP_HTTPS_PORT$TB_MCP_MOUNT_PATH.
TB_MCP_DOMAIN=tb-mcp.localhost

# Ports this stack's proxy publishes. Not 80/443, because the application's
# proxy defaults to those and only one process per host can hold a port. Set
# these to 80/443 when the MCP server has a host to itself.
TB_MCP_HTTP_PORT=8085
TB_MCP_HTTPS_PORT=8445

TB_MCP_TRAEFIK_LOG_LEVEL=INFO

# Basic auth, off by default. Set BOTH to enable it — the middleware is only
# applied when TB_MCP_MIDDLEWARES names it, because a basicauth middleware with
# no users is invalid and Traefik drops the whole router (a 404, not a 401)
# rather than failing open.
#
#   docker run --rm httpd:alpine htpasswd -nb mcp 'your-password'
#
# Double every $ in the hash — compose reads a single one as a variable.
#TB_MCP_MIDDLEWARES=mcp-auth
#TB_MCP_BASIC_AUTH=mcp:$$apr1$$...

# The network this stack's proxy and MCP container share. Change it only if the
# name collides with something else on the host.
#TB_MCP_PROXY_NETWORK=tb-mcp-proxy

# --- Authenticating callers ---------------------------------------------
# The key a client must present to THIS server, as `Authorization: Bearer
# <key>`. Note which direction each key points:
#
#   TB_MCP_API_TOKEN   outbound — what this server shows TestBench.
#   TB_MCP_AUTH_TOKEN  inbound  — what a caller must show this server. Any
#                      random string; it means nothing to TestBench.
#
# Leave it empty and the endpoint is open to anyone who can reach it — the
# server logs a warning saying so on every start. Enforced by the server, so
# unlike the Traefik basic auth above it also covers the published port and
# anything else that bypasses the proxy.
#
#   openssl rand -base64 32
#
# Comma-separate several keys to rotate without downtime, or to give each
# client its own revocable key: add the new one, move clients across, drop the
# old one. Startup logs identify each by a short fingerprint, never the key.
#TB_MCP_AUTH_TOKEN=

# --- Transport ----------------------------------------------------------
# streamable-http for shared/remote clients, stdio for a local desktop client.
TB_MCP_TRANSPORT=streamable-http
TB_MCP_PORT=8003
TB_MCP_MOUNT_PATH=/mcp

# --- Response sizing ----------------------------------------------------
# Rows returned when a tool's `limit` is omitted, and the ceiling it is clamped to.
TB_MCP_DEFAULT_LIMIT=50
TB_MCP_MAX_LIMIT=500
# Byte budget per response. A tool trims its tail to fit and says so with
# `truncated: true`; a paginated tool resumes from the last row kept, so this
# costs a round trip rather than losing rows. Must be large enough to hold a
# full TB_MCP_MAX_LIMIT page or the budget, not the limit, decides page size.
TB_MCP_MAX_RESPONSE_BYTES=131072
