# TestBench backend environment
TB_DATABASE_URL=postgresql+psycopg2://device_manager:device_manager@db:5432/device_manager
TB_JWT_SECRET=change-me-in-production
TB_DEVICE_CREDENTIAL_KEY=
TB_ADMIN_USERNAME=admin
TB_ADMIN_PASSWORD=admin
TB_CORS_ORIGINS=http://localhost:8082,http://localhost:5173
TB_FRONTEND_URL=http://localhost:8082
# Optional on first startup of an empty database; see docs/entity-fields.md.
# TB_ENTITY_FIELDS_JSON={"devices":{"optional_fields":["location"],"custom_fields":[]},"software":{"optional_fields":["version"],"custom_fields":[]},"tests":{"optional_fields":["tag","run_at","notes"],"custom_fields":[]}}

# Authentik OIDC (SSO) — leave issuer empty to disable
# TB_AUTHENTIK_ISSUER=https://authentik.example.com/application/o/testbench/
# TB_AUTHENTIK_CLIENT_ID=...
# TB_AUTHENTIK_CLIENT_SECRET=...
# TB_AUTHENTIK_GROUP_ROLE_MAP=testbench-admins:admin,testbench-testers:tester,testbench-readonly:readonly
# TB_AUTHENTIK_DEFAULT_ROLE=readonly

# Network scanning (online/offline detection)
TB_SCAN_INTERVAL_MINUTES=15
TB_SCAN_TIMEOUT_SECONDS=2
TB_SCAN_CONCURRENCY=10

# On-demand device browser research (requires access to the Docker socket)
TB_DEVICE_INFO_ENABLED=false
TB_DEVICE_INFO_IMAGE=oh-my-pi:latest
TB_DEVICE_INFO_REQUIRED_FIELDS=wan_ip
TB_DEVICE_INFO_URL_FIELD=wan_ip
TB_DEVICE_INFO_PROMPT=Use the browser tool to browse {device_url} and identify this device. Gather useful information about it. Device inventory data: {device_json}
TB_DEVICE_INFO_FORWARD_ENV=LITELLM_API_KEY,DOMAIN,VAULT_SECRET_PATH,VAULT_TOKEN
TB_DEVICE_INFO_NETWORK_MODE=host
